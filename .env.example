# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Optional: Application password for access control
# Remove or leave empty to disable password protection
PASSWORD=your_optional_app_password

# Optional: Auto-delete feature configuration
# DELETE file after xx minutes
AUTO_DELETE=xx

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Get Google OAuth credentials from: https://console.cloud.google.com/
# 4. Enable Google Drive API in your Google Cloud project
# 5. Add http://localhost:3000/oauth2callback to authorized redirect URIs